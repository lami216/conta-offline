{
  "name": "conta-offline",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "tsx --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .next-candidate",
    "desktop:dev": "concurrently -k \"next dev --hostname 127.0.0.1\" \"wait-on http://127.0.0.1:3000 && electron desktop/main.cjs\"",
    "desktop:build": "npm run build",
    "dist:win": "node scripts/dist-win.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "bson": "^6.10.4",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "^1.4.9",
    "concurrently": "^9.2.1",
    "electron": "^38.7.2",
    "electron-builder": "^26.0.12",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "wait-on": "^9.0.3"
  },
  "type": "module",
  "displayName": "Conta Offline",
  "productName": "Conta Offline",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "mr.conta.offline",
    "productName": "Conta Offline",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next"
      },
      {
        "from": ".next/static",
        "to": "next/.next/static"
      },
      {
        "from": "public",
        "to": "next/public"
      },
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "next/node_modules/sql.js/dist/sql-wasm.wasm"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Conta-Offline-Setup-x64.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Conta Offline",
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false
  },
  "description": "Conta accounting and POS desktop offline edition",
  "author": "Conta"
}
